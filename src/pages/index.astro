<!DOCTYPE html>
<html lang='en' data-theme='light'>
<head>
<meta charset='utf-8'>
<meta name='viewport' content='width=device-width,initial-scale=1'>
<meta name='description' content='Kingsley Chinaka - Senior Software Engineer and AI Platform Engineer in Boston, MA.'>
<title>Kingsley Chinaka - Software &amp; AI Platform Engineer</title>
<script is:inline>try{var t=localStorage.getItem('kc-theme');if(!t){t=window.matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light'}document.documentElement.dataset.theme=t}catch(e){}</script>
<style is:global>
:root{--bg:#fafafa;--sf:#ffffff;--tx:#18181b;--mut:#5b6270;--ln:#e4e7ec;--ac:#2563eb;--ac-t:#ffffff;--sh:rgba(0,0,0,.08)}
html[data-theme='dark']{--bg:#0f1115;--sf:#171b22;--tx:#e8eaf0;--mut:#98a0ac;--ln:#272d36;--ac:#7aa2ff;--ac-t:#0f1115;--sh:rgba(0,0,0,.4)}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{font-family:ui-sans-serif,system-ui,-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;background:var(--bg);color:var(--tx);line-height:1.6;transition:background .2s,color .2s}
.wrap{max-width:1040px;margin:0 auto;padding:0 20px}
.nav{position:sticky;top:0;z-index:10;background:var(--bg);border-bottom:1px solid var(--ln)}
.nav .wrap{display:flex;align-items:center;justify-content:space-between;height:60px;gap:12px}
.brand{font-weight:700;text-decoration:none;color:var(--tx);font-size:.98rem}
.nav-links{display:flex;gap:16px;align-items:center}
.nav-links a{color:var(--mut);text-decoration:none;font-size:.95rem}
.nav-links a:hover{color:var(--ac)}
.btn-theme{background:var(--sf);border:1px solid var(--ln);color:var(--tx);border-radius:8px;padding:6px 12px;cursor:pointer;font-size:.85rem;font-family:inherit}
.btn-theme:hover{border-color:var(--ac);color:var(--ac)}
section{padding:60px 0}
.eyebrow{color:var(--ac);font-weight:600;letter-spacing:.08em;text-transform:uppercase;font-size:.78rem}
h1{font-size:clamp(2rem,5vw,3rem);line-height:1.15;margin:8px 0 4px}
h2{font-size:1.55rem;margin:4px 0 20px}
h3{font-size:1.05rem}
p{margin:0}
.lead{color:var(--mut);max-width:660px;font-size:1.06rem;margin-top:10px}
.meta{color:var(--mut);font-size:.95rem;margin-top:12px}
.cta{display:flex;gap:12px;margin-top:24px;flex-wrap:wrap}
.btn{display:inline-block;padding:10px 18px;border-radius:10px;text-decoration:none;font-weight:600;font-size:.95rem;border:1px solid var(--ln);color:var(--tx);background:var(--sf);transition:transform .15s}
.btn.primary{background:var(--ac);color:var(--ac-t);border-color:var(--ac)}
.btn:hover{transform:translateY(-1px)}
.about-copy{color:var(--mut);max-width:720px}
.about-copy strong{color:var(--tx)}
.chip-group{margin-top:22px}
.chip-label{font-weight:600;font-size:.9rem;margin-bottom:8px}
.chips{display:flex;flex-wrap:wrap;gap:8px}
.chip{background:var(--sf);border:1px solid var(--ln);border-radius:999px;padding:4px 12px;font-size:.83rem;color:var(--mut)}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:18px}
.card{background:var(--sf);border:1px solid var(--ln);border-radius:14px;padding:20px;transition:transform .15s ease,box-shadow .15s ease;display:flex;flex-direction:column;gap:8px}
.card:hover{transform:translateY(-3px);box-shadow:0 8px 24px var(--sh)}
.card .role{color:var(--ac);font-size:.82rem;font-weight:600;letter-spacing:.04em;text-transform:uppercase}
.card p{color:var(--mut);font-size:.92rem}
.tags{display:flex;flex-wrap:wrap;gap:6px;margin-top:auto;padding-top:6px}
.tag{font-size:.74rem;border:1px solid var(--ln);border-radius:6px;padding:2px 8px;color:var(--mut)}
.card-link{color:var(--ac);text-decoration:none;font-weight:600;font-size:.9rem}
.card-link:hover{text-decoration:underline}
.contact-grid{display:grid;grid-template-columns:1fr 1.1fr;gap:32px}
ul.links{list-style:none;display:flex;flex-direction:column;gap:12px}
ul.links a{color:var(--tx);text-decoration:none;border-bottom:1px dotted var(--mut);padding-bottom:1px}
ul.links a:hover{color:var(--ac);border-color:var(--ac)}
ul.links span.lbl{color:var(--mut);font-size:.85rem;display:block}
form{display:flex;flex-direction:column;gap:12px;background:var(--sf);border:1px solid var(--ln);border-radius:14px;padding:20px}
input,textarea{background:var(--bg);border:1px solid var(--ln);border-radius:10px;padding:12px;color:var(--tx);font:inherit;width:100%}
input:focus,textarea:focus{outline:2px solid var(--ac);border-color:transparent}
textarea{min-height:120px;resize:vertical}
footer{border-top:1px solid var(--ln);padding:24px 0;color:var(--mut);font-size:.9rem;text-align:center;margin-top:20px}
@media(max-width:800px){.contact-grid{grid-template-columns:1fr}}
@media(max-width:560px){.nav-links{gap:10px}.nav-links a.hide-s{display:none}section{padding:44px 0}}
</style>
</head>
