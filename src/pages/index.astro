<script is:inline>
(function(){var b=document.getElementById('themeBtn');var set=function(t){document.documentElement.dataset.theme=t;localStorage.setItem('kc-theme',t);b.textContent=(t==='dark'?'Light mode':'Dark mode')};set(document.documentElement.dataset.theme||'light');b.addEventListener('click',function(){set(document.documentElement.dataset.theme==='dark'?'light':'dark')});var f=document.getElementById('contactForm');f.addEventListener('submit',function(ev){ev.preventDefault();var n=document.getElementById('cf-name').value;var e=document.getElementById('cf-email').value;var m=document.getElementById('cf-msg').value;var s='Portfolio inquiry from '+n;var body=m+'\n\nReply-to: '+e;window.location.href='mailto:kheengz@gmail.com?subject='+encodeURIComponent(s)+'&body='+encodeURIComponent(body)})})();
</script>
